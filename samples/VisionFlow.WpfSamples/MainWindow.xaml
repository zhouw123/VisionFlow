<Window x:Class="VisionFlow.WpfSamples.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VisionFlow.WpfSamples" xmlns:controls="clr-namespace:VisionFlow.WpfSamples.Controls" xmlns:param="clr-namespace:VisionFlow.WpfSamples.Parameters"
        Title="VisionFlow - WPF Demo"
        Width="1300" Height="800"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#E8E8E8" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Mode:" VerticalAlignment="Center" Margin="8,0,6,0"/>
                <ComboBox x:Name="ModeCombo" Width="200" Height="26" Margin="0,0,8,0"/>
                <Button x:Name="CameraPropsButton" Content="Camera..." Width="100" Height="26" Margin="0,0,4,0"/>
                <Button x:Name="ResetRoiButton" Content="Reset ROI" Width="90" Height="26" Margin="0,0,4,0"/>
                <Button x:Name="ClearRoiButton" Content="Clear ROI" Width="90" Height="26" Margin="0,0,4,0"/>
                <TextBlock Text="(draw ROI with mouse on ORIGINAL image)"
                           VerticalAlignment="Center" Foreground="#666666" Margin="8,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- Left: two stacked video panels -->
            <Grid Grid.Column="0" Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top: original -->
                <Border Grid.Row="0" Background="Black" Margin="0,0,0,2">
                    <Grid>
                        <Image x:Name="VideoImageOriginal" Stretch="Uniform"/>
                        <controls:RoiEditor x:Name="RoiEditControl"/>
                        <Border Background="#80000000" HorizontalAlignment="Left"
                                VerticalAlignment="Top" Padding="6,2,6,2" Margin="4">
                            <TextBlock Text="原始" Foreground="White" FontSize="11"
                                       FontWeight="Bold"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Bottom: processed -->
                <Border Grid.Row="1" Background="Black" Margin="0,2,0,0">
                    <Grid>
                        <Image x:Name="VideoImageProcessed" Stretch="Uniform"/>
                        <Border Background="#80000000" HorizontalAlignment="Left"
                                VerticalAlignment="Top" Padding="6,2,6,2" Margin="4">
                            <TextBlock Text="处理后" Foreground="White" FontSize="11"
                                       FontWeight="Bold"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Right: parameters + analysis -->
            <Grid Grid.Column="1" Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#E0F0E0" BorderBrush="#90B090"
                        BorderThickness="1" Padding="8" Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock Text="Analysis" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                        <TextBlock x:Name="StatsText" FontFamily="Consolas" FontSize="11"
                                   Text="Waiting for data..."/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Background="White">
                    <Grid>
                        <param:ParameterPropertyGrid x:Name="ParamGrid"/>
                        <TextBlock x:Name="EmptyHintText"
                                   Text="No parameters for current mode"
                                   FontSize="14" Foreground="#999999"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="#E8E8E8" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" Text="Waiting..." VerticalAlignment="Center"
                       Margin="8,0,0,0" FontFamily="Consolas" FontSize="12"/>
        </Border>
    </Grid>
</Window>